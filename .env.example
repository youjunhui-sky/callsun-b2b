# ─────────────────────────────────────────────────────────────
# Jinko Rebuild - 环境变量样例
# 复制为 .env 并填入真实值；.env 已加入 .gitignore
# ─────────────────────────────────────────────────────────────

# Cloudflare Pages / Workers 部署
# （这些通常在 Cloudflare Dashboard 上配；本地 dev 不需要）
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# /api/inquiry 端点
# 不填 → mock 模式（返回成功但不真的发出去）
# 配了 → POST JSON 到这个 URL，附 Bearer INQUIRY_WEBHOOK_TOKEN
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=

# Cloudflare Turnstile（/api/inquiry 反垃圾）
# https://www.cloudflare.com/products/turnstile/
# 留空 = 跳过验证（仅 dev 用）
TURNSTILE_SECRET_KEY=

# 站点分析（src/data/site.ts 里读）
# GTM-AW-XXXXXXX 格式
SITE_GTM_ID=
# Cloudflare Web Analytics token (beacon.min.js)
SITE_CF_ANALYTICS_TOKEN=
# Plausible 域名（留空 = 关闭 Plausible）
SITE_PLAUSIBLE_DOMAIN=
