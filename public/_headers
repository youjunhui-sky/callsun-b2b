# Callsun B2B — static asset cache policy (2026-08-16)
# Workers Static Assets 默认 Cache-Control: public, max-age=0, must-revalidate
# → 浏览器每次访问都重新校验所有资源，页面变慢。
# HTML 保持默认（即时更新）；静态资源按类型长缓存。

# 图片 / PDF（无 hash 文件名，改图后 24h 内全站更新）
/uploads/*
  Cache-Control: public, max-age=86400

/blog/*
  Cache-Control: public, max-age=86400

/cases/*
  Cache-Control: public, max-age=86400

/factory/*
  Cache-Control: public, max-age=86400

/hero/*
  Cache-Control: public, max-age=86400

/downloads/*
  Cache-Control: public, max-age=86400

# 根级图片
/logo.png
  Cache-Control: public, max-age=86400

/logo-footer.png
  Cache-Control: public, max-age=86400

/logo-light.png
  Cache-Control: public, max-age=86400

/favicon.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# 带内容 hash 的打包产物：immutable 1 年
/_assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
