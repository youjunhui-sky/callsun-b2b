---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import InquiryForm from '@/components/InquiryForm.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import { SITE } from '@/data/site';
import { SKU_DETAILS } from '@/data/sku-details';
import MobileBanner from '@/components/MobileBanner.astro';
import { SKU_BANNERS } from '@/i18n/data/banner-copy';
import { PRODUCT_FAQ } from '@/data/faq';
import { FAQ_DE } from '@/i18n/data/product-detail-de';
import { LABEL_DE, DETAIL_DE } from '@/i18n/data/product-detail-de';

const sku = SKU_DETAILS.cn180w;

const faqs = FAQ_DE;
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'CN180W Custom N-Type Bifacial Module (25.6% cell efficiency)',
  description: '180W anti-shading TwinCell module for RV rooftops, vans and vehicle-mounted installations.',
  brand: { '@type': 'Brand', name: 'Callsun' },
  manufacturer: { '@type': 'Organization', name: 'Callsun' },
  category: 'Photovoltaic Solar Module',
  productID: 'CN180W',
  sku: 'CN180W',
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Module Efficiency', value: '25.6% cell' },
    { '@type': 'PropertyValue', name: 'Dimensions', value: '1180 × 770 × 35 mm' },
    { '@type': 'PropertyValue', name: 'Weight', value: '9.5 kg' },
  ],
};


---
<BaseLayout
  title={`${sku.model} — ${sku.subtitle} — ${SITE.name}`}
  description={sku.subtitle}
  canonical={`/de/products/${sku.slug}/`}
  schema={[faqSchema, productSchema]}
  locale="de"
>
  <Header slot="header" locale="de" />
  <Footer slot="footer" locale="de" />

  {/* ═══════════════════════════════════════════════════════════════════════
       Section 1: Hero banner (full-width marketing image)
       ═══════════════════════════════════════════════════════════════════════ */}
  <section class="bg-white">
    <MobileBanner
      desktop="/uploads/callsun/products/180w/hero-banner.webp"
      mobile="/uploads/callsun/products/mobile/cn180w-hero.webp"
      copy={SKU_BANNERS.cn180w.en.hero}
      alt={`${sku.model} — Compact Bifacial Module for Flexible System Design`}
      eager
    />
  </section>

  {/* ═══════════════════════════════════════════════════════════════════════
       Section 2: Product Features (full-width image)
       ═══════════════════════════════════════════════════════════════════════ */}
  <section class="bg-white">
    <MobileBanner
      desktop="/uploads/callsun/products/180w/features-banner.webp"
      mobile="/uploads/callsun/products/mobile/cn180w-features.webp"
      copy={SKU_BANNERS.cn180w.en.features}
      alt={`${sku.model} — Product Features`}
    />
  </section>

  {/* ═══════════════════════════════════════════════════════════════════════
       Section 3: Technical Specifications (3 columns, dark bg)
       ═══════════════════════════════════════════════════════════════════════ */}
  <section class="bg-callsun-ink text-white">
    <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-16 md:py-20 lg:py-24">
      <Eyebrow class="mb-4">TECHNISCHE SPEZIFIKATIONEN</Eyebrow>
      <h2 class="font-display text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-white leading-[1.1] max-w-4xl">
        {sku.model} Datenblatt
      </h2>

      <div class="mt-10 md:mt-12 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
        {[
          { title: 'ELEKTRISCH',              rows: sku.tech.electrical },
          { title: 'MECHANISCH',              rows: sku.tech.mechanical },
          { title: 'TEMPERATUR & LIEFERUNG',  rows: sku.tech.thermal },
        ].map((col) => (
          <div class="bg-white/5 border border-white/10 p-6 md:p-7">
            <p class="text-[11px] md:text-xs font-bold tracking-eyebrow uppercase text-callsun-lime mb-5">
              {col.title}
            </p>
            <dl class="grid grid-cols-1 gap-y-3">
              {col.rows.map((r) => (
                <div class="border-t border-white/10 pt-2">
                  <dt class="text-[10px] font-bold tracking-eyebrow text-white/60">{LABEL_DE[r.label] || r.label}</dt>
                  <dd class="mt-1 font-semibold text-sm text-white">{r.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>

      <p class="mt-8 text-center text-white/50 text-xs md:text-sm">
        STC: Einstrahlung 1000 W/m² · Zelltemperatur 25 °C · Luftmasse 1,5
      </p>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════════════
       Section 4: Documents & Inquiry
       ═══════════════════════════════════════════════════════════════════════ */}
  <FaqAccordion items={faqs} model={sku.model} heading="Häufige Fragen" />

  <section id="inquiry" class="relative bg-callsun-tint overflow-hidden">
    <div
      class="absolute inset-0 opacity-[0.35]"
      aria-hidden="true"
      style="background-image: linear-gradient(rgba(0,0,0,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.06) 1px, transparent 1px); background-size: 48px 48px;"
    ></div>
    <div class="relative mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-16 md:py-20 lg:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16 items-start">
        {/* LEFT: documents (lg:col-span-2) */}
        <div class="lg:col-span-2">
          <Eyebrow class="mb-4">DOKUMENTE & ANFRAGE</Eyebrow>
          <h2 class="font-display text-2xl sm:text-3xl md:text-4xl font-extrabold text-callsun-ink leading-[1.1]">
            {sku.model} product resources
          </h2>

          <div class="mt-6 space-y-2">
            {sku.certifications.map((c) => (
              <p class="text-sm md:text-base text-callsun-mute font-medium">
                {c}
              </p>
            ))}
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            {sku.datasheet && (
              <a
                href={sku.datasheet}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 bg-callsun-ink text-white font-bold text-sm tracking-wider px-6 py-3.5 hover:bg-callsun hover:text-callsun-ink transition-colors"
              >
                DATENBLATT HERUNTERLADEN <span aria-hidden="true">↓</span>
              </a>
            )}
            <a
              href="#inquiry-form"
              class="inline-flex items-center gap-2 bg-white border-2 border-callsun-line text-callsun-ink font-bold text-sm tracking-wider px-6 py-3 hover:border-callsun-ink transition-colors"
            >
              INSTALLATIONSHANDBUCH <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        {/* RIGHT: inquiry form (lg:col-span-3) */}
        <div class="lg:col-span-3" id="inquiry-form">
          <InquiryForm
            locale="de"
            formSource={`sku-${sku.slug}-de`}
            formTitle={`${sku.model} PRODUKTANFRAGE`}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
