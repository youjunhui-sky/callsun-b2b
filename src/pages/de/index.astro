---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import InquiryForm from '@/components/InquiryForm.astro';
import SocialIcons from '@/components/SocialIcons.astro';
import HeroMobileCopy from '@/components/HeroMobileCopy.astro';
import { SITE } from '@/data/site';
import { UI } from '@/i18n/ui';
import { HOME_PRODUCTS_DE, INQUIRY_DE } from '@/i18n/data/home-de';
import { QUALITY, ARTICLES, VIDEOS } from '@/data/homepage';

const t = UI.de;
const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.domain,
};
---
<BaseLayout
  title={`${SITE.name} — ${t.footer.tagline}`}
  description={INQUIRY_DE.intro}
  canonical="/de/"
  locale="de"
  schema={homeSchema}
>
  <Header slot="header" locale="de" />
  <Footer slot="footer" locale="de" />

  <section id="hero-carousel" class="relative overflow-hidden text-white">
    <div class="relative w-full aspect-[3/4] md:aspect-[11/5] md:min-h-[380px]">
      {[1, 2, 3, 4, 5, 6, 7].map((n) => (
        <picture>
        <source media="(max-width: 767px)" srcset={`/uploads/callsun/home/hero-carousel/mobile/${n}.webp`} type="image/webp" />
        <img
          src={`/uploads/callsun/home/hero-carousel/${n}.webp`}
          alt=""
          loading={n === 1 ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={n === 1 ? 'high' : 'auto'}
          class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ${n === 1 ? 'opacity-100' : 'opacity-0'}`}
          style='object-position: center;'
          data-slide={n}
        />
        </picture>
      ))}
      <button type="button" aria-label="Vorherige Folie" data-prev class="absolute left-3 md:left-6 top-1/2 -translate-y-1/2 z-10 flex h-10 w-10 md:h-12 md:w-12 items-center justify-center rounded-full bg-black/15 text-white/60 hover:bg-callsun hover:text-callsun-ink transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
      </button>
      <button type="button" aria-label="Nächste Folie" data-next class="absolute right-3 md:right-6 top-1/2 -translate-y-1/2 z-10 flex h-10 w-10 md:h-12 md:w-12 items-center justify-center rounded-full bg-black/15 text-white/60 hover:bg-callsun hover:text-callsun-ink transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </button>
      <HeroMobileCopy locale="de" />
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-16 md:py-20 lg:py-24">
      <div class="mb-10 md:mb-14">
        <div class="flex items-baseline gap-3 md:gap-4 mb-5 md:mb-6">
          <h3 class="font-display font-extrabold text-callsun-lime text-base md:text-lg uppercase tracking-eyebrow shrink-0">{t.home.standardHeading}</h3>
          <div class="flex-1 h-px bg-callsun-line"></div>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
          {HOME_PRODUCTS_DE.filter((p) => p.tag === 'STANDARD').map((p) => (
            <li>
              <a href={p.href} class="group flex flex-col h-full border border-callsun-line bg-white hover:border-callsun-ink hover:shadow-card transition-all">
                <div class="relative aspect-square overflow-hidden bg-callsun-surface">
                  <img src={p.image} alt={p.name} loading="lazy" decoding="async" class="w-full h-full object-contain p-4 transition-transform duration-500 group-hover:scale-[1.04]" />
                </div>
                <div class="flex-1 p-4 md:p-5 flex flex-col gap-2">
                  <p class="text-xs font-bold tracking-eyebrow uppercase text-callsun-lime">{p.model}</p>
                  <h4 class="font-display font-bold text-[15px] leading-snug flex-1 text-callsun-ink">{p.name}</h4>
                  <span class="text-xs font-semibold tracking-wider mt-1 inline-flex items-center gap-1 text-callsun-ink group-hover:text-callsun-lime">
                    {t.home.productDetails}
                    <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <div class="flex items-baseline gap-3 md:gap-4 mb-5 md:mb-6">
          <h3 class="font-display font-extrabold text-callsun-lime text-base md:text-lg uppercase tracking-eyebrow shrink-0">{t.home.customHeading}</h3>
          <div class="flex-1 h-px bg-callsun-line"></div>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
          {HOME_PRODUCTS_DE.filter((p) => p.tag === 'CUSTOM').map((p) => (
            <li>
              <a href={p.href} class="group flex flex-col h-full border border-callsun-line bg-white hover:border-callsun-ink hover:shadow-card transition-all">
                <div class="relative aspect-square overflow-hidden bg-callsun-surface">
                  <img src={p.image} alt={p.name} loading="lazy" decoding="async" class="w-full h-full object-contain p-4 transition-transform duration-500 group-hover:scale-[1.04]" />
                </div>
                <div class="flex-1 p-4 md:p-5 flex flex-col gap-2">
                  <p class="text-xs font-bold tracking-eyebrow uppercase text-callsun-lime">{p.model}</p>
                  <h4 class="font-display font-bold text-[15px] leading-snug flex-1 text-callsun-ink">{p.name}</h4>
                  <span class="text-xs font-semibold tracking-wider mt-1 inline-flex items-center gap-1 text-callsun-ink group-hover:text-callsun-lime">
                    {t.home.productDetails}
                    <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-callsun-tint">
    <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-16 md:py-20 lg:py-24">
      <img src={QUALITY.certificateImage} alt="Callsun Produktzertifikate" loading="lazy" class="block w-full h-auto object-contain" />
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-16 md:py-20 lg:py-24">
      <img src="/uploads/callsun/homepage/global-supply.webp" alt="Callsun Fertigungsstandorte und Logistiknetzwerk" loading="lazy" class="block w-full h-auto object-cover" />
    </div>
  </section>

  <section id="inquiry" class="bg-callsun-ink text-white">
    <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-16 md:py-20 lg:py-24">
      <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] gap-10 lg:gap-16 items-start">
        <div>
          <Eyebrow class="mb-3">{INQUIRY_DE.eyebrow}</Eyebrow>
          <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-extrabold text-white leading-[1.1]">
            {INQUIRY_DE.title}
          </h2>
          <p class="mt-6 text-white/70 text-base leading-relaxed max-w-lg">
            {INQUIRY_DE.intro}
          </p>
          <SocialIcons class="mt-8" />
        </div>
        <InquiryForm locale="de" formSource="homepage-de" formTitle={INQUIRY_DE.formTitle} />
      </div>
    </div>
  </section>

  <script>
  (() => {
    const TOTAL = 7;
    let current = 1;
    let timer = null;
    const slides = document.querySelectorAll('[data-slide]');
    const section = document.getElementById('hero-carousel');
    function goTo(n) {
      if (n === current) return;
      slides.forEach((el) => { el.classList.remove('opacity-100'); el.classList.add('opacity-0'); });
      document.querySelectorAll(`[data-slide="${n}"]`).forEach((el) => { el.classList.remove('opacity-0'); el.classList.add('opacity-100'); });
      current = n;
    }
    const next = () => goTo(current < TOTAL ? current + 1 : 1);
    const prev = () => goTo(current > 1 ? current - 1 : TOTAL);
    function startAuto() { stopAuto(); timer = setInterval(next, 4000); }
    function stopAuto() { if (timer) { clearInterval(timer); timer = null; } }
    const prevBtn = document.querySelector('[data-prev]');
    const nextBtn = document.querySelector('[data-next]');
    if (prevBtn) prevBtn.addEventListener('click', () => { prev(); startAuto(); });
    if (nextBtn) nextBtn.addEventListener('click', () => { next(); startAuto(); });
    if (section) {
      section.addEventListener('mouseenter', stopAuto);
      section.addEventListener('mouseleave', startAuto);
    }
    startAuto();
  })();
  </script>
</BaseLayout>
