---
import BaseLayout from '@/layouts/BaseLayout.astro';
import InquiryForm from '@/components/InquiryForm.astro';
import {
  APPLICATIONS,
  APPLICATION_WORKFLOW,
  APPLICATION_FAQ,
} from '@/data/applications';

const pageTitle = 'Applications — Callsun Solar B2B';
const pageDescription =
  'Solar application scenarios for B2B distributors, dealers and EPC installers. C&I rooftop, home storage, off-grid remote power.';
---

<BaseLayout title={pageTitle} description={pageDescription}>

  {/* ---------- 1) SHORT DARK HERO ---------- */}
  <section class="bg-callsun-ink text-white py-14 md:py-16">
    <div class="max-w-wide mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-eyebrow text-callsun-lime font-extrabold">
        Applications
      </p>
      <h1 class="mt-3 text-4xl md:text-5xl lg:text-6xl font-display font-extrabold leading-[0.95]">
        Application Scenarios
      </h1>
      <p class="mt-4 text-base md:text-lg text-white/70 max-w-2xl">
        Solar system paths for B2B distributors, dealers and EPC installers.
      </p>
    </div>
  </section>

  {/* ---------- 2) SCENARIOS with tinted-image background band ---------- */}
  <section class="relative bg-callsun-ink text-white py-16 md:py-20 border-t border-white/10 overflow-hidden">
    {/* aerial industrial photo overlay */}
    <div
      class="absolute inset-0 opacity-25 pointer-events-none"
      style="background-image: url('/uploads/callsun/solutions/12kw/01-system-overview.webp'); background-size: cover; background-position: center;"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 pointer-events-none" style="background-color: rgba(15, 15, 14, 0.6);" aria-hidden="true"></div>

    <div class="relative z-10 max-w-wide mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-eyebrow text-callsun-lime font-extrabold">
        Scenario-led paths
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold leading-tight">
        Choose your project scenario
      </h2>
      <p class="mt-3 text-base md:text-lg text-white/70 max-w-2xl">
        Start from a real project instead of a part number. Each path links to the right products, packages and inquiry route.
      </p>

      {/* Search / filter row (visual only, no search backend yet) */}
      <div class="mt-8 flex flex-col sm:flex-row gap-2 bg-white shadow-card">
        <input
          type="search"
          placeholder="Filter by keyword (rooftop, home storage, off-grid...)"
          class="flex-1 px-5 py-4 text-callsun-ink placeholder:text-callsun-mute text-sm md:text-base focus:outline-none focus:ring-2 focus:ring-callsun-lime bg-white"
          disabled
        />
        <button
          type="button"
          class="shrink-0 inline-flex items-center gap-2 bg-callsun-ink text-white font-display font-bold text-xs md:text-sm uppercase tracking-eyebrow px-6 py-4 hover:bg-callsun-dark transition-colors"
        >
          All scenarios
          <span aria-hidden="true">▾</span>
        </button>
      </div>

      {/* 3 SCENARIO CARDS */}
      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
        {APPLICATIONS.map((app, i) => (
          <a
            href={`#${app.slug}`}
            class="group relative bg-white shadow-card flex flex-col overflow-hidden transition-all hover:shadow-lg"
          >
            {/* lime top accent line */}
            <div class="h-1 w-full bg-callsun-lime" aria-hidden="true"></div>
            <div class="p-6 md:p-8 flex-1 flex flex-col">
              <div class="flex items-start justify-between">
                <span class="font-display font-extrabold text-callsun-ink text-sm">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="text-xs uppercase tracking-eyebrow text-callsun-mute font-bold">
                  {app.eyebrow}
                </span>
              </div>
              <h3 class="mt-6 font-display font-extrabold text-callsun-ink text-lg md:text-xl uppercase tracking-wide leading-snug">
                {app.title}
              </h3>
              <p class="mt-3 text-sm md:text-base text-callsun-mute leading-relaxed flex-1">
                {app.intro}
              </p>
              <div class="mt-6 inline-flex items-center gap-2 font-display font-bold text-callsun-ink text-xs uppercase tracking-eyebrow group-hover:text-callsun-lime transition-colors">
                Learn more
                <span class="text-callsun-lime" aria-hidden="true">↓</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <p class="mt-6 text-xs text-white/60 max-w-2xl">
        Scenario recommendations are informational. Contact Callsun for market-specific BOM and packaging references.
      </p>
    </div>
  </section>

  {/* ---------- 3) DETAILED SCENARIO SECTIONS (white / tint alternating, anchored) ---------- */}
  {APPLICATIONS.map((app, i) => (
    <section
      id={app.slug}
      class={`${i % 2 === 0 ? 'bg-white' : 'bg-callsun-tint'} py-16 md:py-20 border-t border-callsun-line scroll-mt-20`}
    >
      <div class="max-w-wide mx-auto px-4 lg:px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
          <div class={i % 2 === 0 ? 'lg:order-1' : 'lg:order-2'}>
            <p class="text-xs uppercase tracking-eyebrow text-callsun-lime font-extrabold">
              {app.eyebrow}
            </p>
            <h2 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-callsun-ink leading-tight">
              Start with {app.title}
            </h2>
            <p class="mt-5 text-lg text-callsun-ink/80 leading-relaxed">
              {app.bestFor}
            </p>

            <div class="mt-8">
              <p class="text-xs uppercase tracking-eyebrow text-callsun-mute font-bold">
                What you get
              </p>
              <ul class="mt-4 space-y-3">
                {app.highlights.map((h) => (
                  <li class="flex items-start gap-3">
                    <span class="shrink-0 mt-1.5 w-2 h-2 bg-callsun-lime" aria-hidden="true"></span>
                    <span class="text-callsun-ink text-base leading-snug">{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-8">
              <p class="text-xs uppercase tracking-eyebrow text-callsun-mute font-bold">
                Recommended paths
              </p>
              <div class="mt-4 flex flex-wrap gap-2">
                {app.linkedSolutions.map((s) => (
                  <a
                    href={s.href}
                    class="inline-flex items-center gap-2 bg-white border border-callsun-line hover:border-callsun-lime text-callsun-ink font-display font-bold text-xs uppercase tracking-eyebrow px-4 py-2.5 transition-colors"
                  >
                    {s.label}
                    <span aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            </div>
          </div>

          <figure class={i % 2 === 0 ? 'lg:order-2' : 'lg:order-1'}>
            <div class="relative bg-white border border-callsun-line shadow-card overflow-hidden" style="aspect-ratio: 4/3;">
              <img
                src={app.image}
                alt={app.title}
                class="absolute inset-0 w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          </figure>
        </div>
      </div>
    </section>
  ))}

  {/* ---------- 4) FAQ (white, single accordion container) ---------- */}
  <section class="bg-white py-16 md:py-20 border-t border-callsun-line">
    <div class="max-w-wide mx-auto px-4 lg:px-6">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-eyebrow text-callsun-lime font-extrabold">
          Frequently Asked Questions
        </p>
        <h2 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-callsun-ink leading-tight">
          Application and Path FAQ
        </h2>
        <p class="mt-4 text-base md:text-lg text-callsun-mute max-w-2xl">
          Answers for distributors, installers, EPCs and project buyers.
        </p>
      </div>

      <div class="mt-10 border border-callsun-line bg-white shadow-card overflow-hidden">
        {APPLICATION_FAQ.map((f, i) => (
          <details class="group border-b border-callsun-line last:border-b-0">
            <summary class="flex items-start gap-4 md:gap-6 px-6 py-5 md:px-8 md:py-6 cursor-pointer list-none hover:bg-callsun-tint/50 transition-colors">
              <span class="shrink-0 font-display font-extrabold text-callsun-lime text-lg md:text-xl leading-none pt-0.5">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="flex-1 font-display font-bold text-callsun-ink text-base md:text-lg leading-snug">
                {f.q}
              </span>
              <span
                class="shrink-0 text-callsun-mute font-display font-extrabold text-2xl leading-none pt-0.5 group-open:rotate-45 transition-transform"
                aria-hidden="true"
              >+</span>
            </summary>
            <div class="px-6 pb-6 pl-14 md:px-8 md:pb-8 md:pl-20 text-callsun-mute leading-relaxed">
              {f.a}
            </div>
          </details>
        ))}
      </div>
      <p class="mt-4 text-xs text-callsun-mute">Select a question to expand the answer.</p>
    </div>
  </section>

  {/* ---------- 5) WORKFLOW GRID on light bg ---------- */}
  <section class="bg-callsun-bg py-16 md:py-20 border-t border-callsun-line">
    <div class="max-w-wide mx-auto px-4 lg:px-6">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-eyebrow text-callsun-lime font-extrabold">
          Inquiry workflow
        </p>
        <h2 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-callsun-ink leading-tight">
          From application page to qualified RFQ
        </h2>
        <p class="mt-4 text-base md:text-lg text-callsun-mute max-w-2xl">
          Send enough context on the first message so sales can reply with a package path, not just a spec sheet.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
        {APPLICATION_WORKFLOW.map((s) => (
          <div class="relative bg-white shadow-card flex flex-col">
            <div class="h-1 w-full bg-callsun-lime" aria-hidden="true"></div>
            <div class="p-6 md:p-8 flex-1">
              <span class="font-display font-extrabold text-callsun-ink text-sm">
                {s.step}
              </span>
              <h3 class="mt-6 font-display font-extrabold text-callsun-ink text-lg md:text-xl uppercase tracking-wide leading-snug">
                {s.title}
              </h3>
              <p class="mt-3 text-sm md:text-base text-callsun-mute leading-relaxed">
                {s.body}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- 6) DARK CONTACT CTA BAND ---------- */}
  <section id="inquiry" class="bg-callsun-ink text-white py-16 md:py-20 scroll-mt-20">
    <div class="max-w-wide mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-eyebrow text-callsun-lime font-extrabold">
        Not sure which path fits your project?
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold leading-tight">
        Contact the Callsun team
      </h2>
      <p class="mt-4 text-base md:text-lg text-white/70 max-w-2xl">
        Send load type, target capacity, installation market and timeline. Callsun will recommend a product or package path with the first reply.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 bg-callsun-lime text-callsun-ink font-display font-extrabold text-sm uppercase tracking-eyebrow px-6 py-3.5 hover:bg-callsun-limeHi transition-colors"
        >
          Send an inquiry
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 text-callsun-lime font-display font-extrabold text-sm uppercase tracking-eyebrow px-2 py-3.5 hover:text-white transition-colors"
        >
          Contact support
          <span aria-hidden="true">→</span>
        </a>
      </div>

      {/* micro-footer split */}
      <div class="mt-14 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs uppercase tracking-eyebrow text-white/50">
        <span>© CALLSUN</span>
        <span>APPLICATIONS</span>
      </div>
    </div>
  </section>
</BaseLayout>
