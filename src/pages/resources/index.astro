---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DOWNLOAD_CATEGORIES, RESOURCE_FAQ, VIDEO_CARDS } from '@/data/resources';

const pageTitle = 'Resource Center — Callsun Solar B2B';
const pageDescription =
  'Callsun Resource Center: technical datasheets, installation manuals, certificates, product FAQ and independent video reviews for B2B distributors and EPC installers.';
---

<BaseLayout title={pageTitle} description={pageDescription}>

  {/* ---------- 1) SHORT DARK HERO ---------- */}
  <section class="bg-callsun-ink text-white py-14 md:py-16">
    <div class="max-w-wide mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-eyebrow text-callsun-lime font-extrabold">
        Resources
      </p>
      <h1 class="mt-3 text-4xl md:text-5xl lg:text-6xl font-display font-extrabold leading-[0.95]">
        Resource Center
      </h1>
      <p class="mt-4 text-base md:text-lg text-white/70 max-w-2xl">
        Technical documents, product support and video resources.
      </p>
    </div>
  </section>

  {/* ---------- 2) DOWNLOADS with aerial-photo overlay bg ---------- */}
  <section class="relative bg-callsun-ink text-white py-16 md:py-20 border-t border-white/10 overflow-hidden">
    {/* aerial industrial photo overlay */}
    <div
      class="absolute inset-0 opacity-25 pointer-events-none"
      style="background-image: url('/uploads/callsun/solutions/12kw/01-system-overview.webp'); background-size: cover; background-position: center;"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0 pointer-events-none"
      style="background-color: rgba(15, 15, 14, 0.6);"
      aria-hidden="true"
    ></div>

    <div class="relative z-10 max-w-wide mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-eyebrow text-callsun-lime font-extrabold">
        Technical Documents
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold leading-tight">
        Downloads
      </h2>
      <p class="mt-3 text-base md:text-lg text-white/70 max-w-2xl">
        Access product specifications, manuals and available compliance documents.
      </p>

      {/* search + dropdown row */}
      <div class="mt-8 flex flex-col sm:flex-row bg-white shadow-card">
        <input
          type="search"
          placeholder="Search by product model or document type"
          class="flex-1 px-5 py-4 text-callsun-ink placeholder:text-callsun-mute text-sm md:text-base focus:outline-none focus:ring-2 focus:ring-callsun-lime bg-white"
          disabled
        />
        <button
          type="button"
          class="shrink-0 inline-flex items-center gap-2 bg-callsun-ink text-white font-display font-bold text-xs md:text-sm uppercase tracking-eyebrow px-6 py-4 hover:bg-callsun-dark transition-colors"
        >
          All documents
          <span aria-hidden="true">▾</span>
        </button>
      </div>

      {/* 3 white cards, lime top accent, 01/02/03 top-left */}
      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
        {DOWNLOAD_CATEGORIES.map((c) => (
          <a
            href={c.href}
            class="group relative bg-white shadow-card flex flex-col overflow-hidden transition-all hover:shadow-lg"
          >
            <div class="h-1 w-full bg-callsun-lime" aria-hidden="true"></div>
            <div class="p-6 md:p-8 flex-1 flex flex-col">
              <span class="font-display font-extrabold text-callsun-ink text-sm">
                {c.step}
              </span>
              <h3 class="mt-6 font-display font-extrabold text-callsun-ink text-lg md:text-xl uppercase tracking-wide leading-snug">
                {c.title}
              </h3>
              <p class="mt-3 text-sm md:text-base text-callsun-mute leading-relaxed flex-1">
                {c.body}
              </p>
              <div class="mt-8 inline-flex items-center gap-2 font-display font-extrabold text-callsun-ink text-xs uppercase tracking-eyebrow group-hover:text-callsun-lime transition-colors">
                {c.cta}
                <span class="text-callsun-lime" aria-hidden="true">↓</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <p class="mt-6 text-xs text-white/60 max-w-2xl">
        Documents are provided by product model. Contact Callsun if a required file is not listed.
      </p>
    </div>
  </section>

  {/* ---------- 3) FAQ (white bg, single accordion) ---------- */}
  <section class="bg-white py-16 md:py-20 border-t border-callsun-line">
    <div class="max-w-wide mx-auto px-4 lg:px-6">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-eyebrow text-callsun-lime font-extrabold">
          Frequently Asked Questions
        </p>
        <h2 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-callsun-ink leading-tight">
          Product and Cooperation FAQ
        </h2>
        <p class="mt-4 text-base md:text-lg text-callsun-mute max-w-2xl">
          Answers for distributors, installers, EPCs, equipment manufacturers and project buyers.
        </p>
      </div>

      <div class="mt-10 border border-callsun-line bg-white shadow-card overflow-hidden">
        {RESOURCE_FAQ.map((f, i) => (
          <details class="group border-b border-callsun-line last:border-b-0">
            <summary class="flex items-start gap-4 md:gap-6 px-6 py-5 md:px-8 md:py-6 cursor-pointer list-none hover:bg-callsun-tint/50 transition-colors">
              <span class="shrink-0 font-display font-extrabold text-callsun-lime text-lg md:text-xl leading-none pt-0.5">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="flex-1 font-display font-bold text-callsun-ink text-base md:text-lg leading-snug">
                {f.q}
              </span>
              <span
                class="shrink-0 text-callsun-mute font-display font-extrabold text-2xl leading-none pt-0.5 group-open:rotate-45 transition-transform"
                aria-hidden="true"
              >+</span>
            </summary>
            <div class="px-6 pb-6 pl-14 md:px-8 md:pb-8 md:pl-20 text-callsun-mute leading-relaxed">
              {f.a}
            </div>
          </details>
        ))}
      </div>
      <p class="mt-4 text-xs text-callsun-mute">Select a question to expand the answer.</p>
    </div>
  </section>

  {/* ---------- 4) VIDEO CENTER (light off-white bg) ---------- */}
  <section class="bg-callsun-bg py-16 md:py-20 border-t border-callsun-line">
    <div class="max-w-wide mx-auto px-4 lg:px-6">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-eyebrow text-callsun-lime font-extrabold">
          Video Center
        </p>
        <h2 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold text-callsun-ink leading-tight">
          Product Reviews and Technical Videos
        </h2>
        <p class="mt-4 text-base md:text-lg text-callsun-mute max-w-2xl">
          Watch independent product reviews and Callsun technical testing content.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
        {VIDEO_CARDS.map((v) => (
          <article class="group bg-white shadow-card flex flex-col overflow-hidden">
            <div class="relative bg-callsun-ink" style="aspect-ratio: 16/9;">
              <img
                src={v.thumb}
                alt={v.title}
                class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity"
                loading="lazy"
              />
              {/* VIDEO badge top-left */}
              <span class="absolute top-3 left-3 bg-callsun-ink text-white text-xs font-display font-extrabold uppercase tracking-eyebrow px-2.5 py-1 z-10">
                {v.badge}
              </span>
              {/* circular play button center */}
              <button
                type="button"
                aria-label="Play video"
                class="absolute inset-0 flex items-center justify-center z-10 pointer-events-none"
              >
                <span class="inline-flex items-center justify-center w-16 h-16 md:w-20 md:h-20 rounded-full bg-white/95 shadow-card group-hover:bg-callsun-lime transition-colors">
                  <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" class="text-callsun-ink translate-x-0.5">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </span>
              </button>
            </div>
            <div class="p-5 md:p-6 flex flex-col flex-1 border-t border-callsun-line">
              <h3 class="font-display font-bold text-callsun-ink text-base md:text-lg leading-snug">
                {v.title}
              </h3>
              <p class="mt-3 text-sm text-callsun-mute leading-relaxed flex-1">
                {v.body}
              </p>
              <p class="mt-4 text-xs uppercase tracking-eyebrow text-callsun-lime font-extrabold">
                {v.credit}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ---------- 5) DARK CONTACT CTA BAND ---------- */}
  <section class="bg-callsun-ink text-white py-16 md:py-20">
    <div class="max-w-wide mx-auto px-4 lg:px-6">
      <p class="text-xs uppercase tracking-eyebrow text-callsun-lime font-extrabold">
        Need a document or technical answer?
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl lg:text-5xl font-display font-extrabold leading-tight">
        Contact the Callsun Team
      </h2>
      <p class="mt-4 text-base md:text-lg text-white/70 max-w-2xl">
        Tell us the product model, target market and documentation required.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 bg-callsun-lime text-callsun-ink font-display font-extrabold text-sm uppercase tracking-eyebrow px-6 py-3.5 hover:bg-callsun-limeHi transition-colors"
        >
          Send an inquiry
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 text-callsun-lime font-display font-extrabold text-sm uppercase tracking-eyebrow px-2 py-3.5 hover:text-white transition-colors"
        >
          Contact support
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mt-14 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs uppercase tracking-eyebrow text-white/50">
        <span>© CALLSUN</span>
        <span>RESOURCE CENTER</span>
      </div>
    </div>
  </section>
</BaseLayout>
