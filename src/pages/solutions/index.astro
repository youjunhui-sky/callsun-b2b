---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { SITE } from '@/data/site';
import { SOLUTIONS_L1 } from '@/data/solutions-l1';

const gridTiedKits = SOLUTIONS_L1.kits.filter((k) => k.category === 'grid-tied');
const offGridKits  = SOLUTIONS_L1.kits.filter((k) => k.category === 'off-grid');

const gridTiedFeatured = gridTiedKits[0];
const offGridFeatured  = offGridKits[0];
---
<BaseLayout
  title={`Solar System Solutions — ${SITE.name}`}
  description={SOLUTIONS_L1.hero.subtitle}
  canonical="/solutions/"
>
  <Header slot="header" />
  <Footer slot="footer" />

  {/* ═══════════════════════════════════════════════════════════════════════
       Hero — dark bg + lime accent bar on left of title block
       ═══════════════════════════════════════════════════════════════════════ */}
  <section class="bg-callsun-ink text-white">
    <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 pt-16 pb-16 md:pt-20 md:pb-20">
      <Breadcrumbs items={SOLUTIONS_L1.breadcrumb} theme="dark" />
      <div class="mt-8 flex items-start gap-6">
        <div class="w-1 self-stretch bg-callsun" aria-hidden="true"></div>
        <div class="flex-1">
          <p class="text-[11px] md:text-xs font-bold tracking-eyebrow uppercase text-callsun-lime">
            {SOLUTIONS_L1.hero.eyebrow}
          </p>
          <h1 class="mt-3 font-display text-4xl md:text-5xl lg:text-6xl font-extrabold leading-[1.05]">
            {SOLUTIONS_L1.hero.title}
          </h1>
          <p class="mt-4 text-white/75 text-base md:text-lg leading-relaxed max-w-2xl">
            {SOLUTIONS_L1.hero.subtitle}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════════════
       Grid-Tied / Hybrid block  (featured split has hero image as bg)
       ═══════════════════════════════════════════════════════════════════════ */}
  <section class="bg-white border-b border-callsun-line">
    <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-16 md:py-20 lg:py-24">

      {/* Featured hero: full designed image (keeps designer's title / specs / CTA panel) */}
      <div
        class="relative overflow-hidden"
        style="aspect-ratio: 1947 / 808;"
      >
        <img
          src="/uploads/callsun/solutions/hero-5-4kw-hybrid.jpg"
          alt={gridTiedFeatured.name}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover"
        />
      </div>

      {/* Divider + sub-header */}
      <hr class="mt-16 border-t border-callsun-line" />
      <Eyebrow class="mt-10 mb-6">{SOLUTIONS_L1.gridTied.subEyebrow}</Eyebrow>

      {/* 2-card row (horizontal: square image left, text right) */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {gridTiedKits.map((k) => (
          <a
            href={`/solutions/${k.slug}/`}
            class="group grid grid-cols-1 md:grid-cols-5 gap-0 border border-callsun-line hover:border-callsun-ink transition-colors overflow-hidden bg-white"
          >
            <div class="md:col-span-3 relative bg-callsun-tint aspect-square">
              <img
                src={k.cardImage}
                alt=""
                loading="lazy"
                class="absolute inset-0 w-full h-full object-contain p-4 md:p-6"
              />
            </div>
            <div class="md:col-span-2 p-6 md:p-8 flex flex-col justify-center gap-3">
              <h4 class="font-display text-lg md:text-xl font-extrabold text-callsun-ink leading-snug">
                {k.short}
              </h4>
              <p class="text-callsun-mute text-sm">
                {k.specsInline}
              </p>
              <span class="mt-2 inline-flex items-center gap-2 font-bold text-xs tracking-wider uppercase text-callsun-ink group-hover:text-callsun-lime transition-colors">
                VIEW SYSTEM <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════════════
       Off-Grid block  (featured split has hero image as bg)
       ═══════════════════════════════════════════════════════════════════════ */}
  <section class="bg-callsun-tint border-b border-callsun-line">
    <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-16 md:py-20 lg:py-24">

      {/* Featured hero: full designed image (keeps designer's title / specs / CTA panel) */}
      <div
        class="relative overflow-hidden"
        style="aspect-ratio: 1942 / 809;"
      >
        <img
          src="/uploads/callsun/solutions/hero-off-grid.jpg"
          alt="Off-Grid Solar Power Systems"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover"
        />
      </div>

      {/* Divider + sub-header */}
      <hr class="mt-16 border-t border-callsun-line" />
      <Eyebrow class="mt-10 mb-6">{SOLUTIONS_L1.offGrid.subEyebrow}</Eyebrow>

      {/* 2-card row (horizontal: square image left, text right) */}
      <div id="off-grid-systems" class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {offGridKits.map((k) => (
          <a
            href={`/solutions/${k.slug}/`}
            class="group grid grid-cols-1 md:grid-cols-5 gap-0 border border-callsun-line hover:border-callsun-ink transition-colors overflow-hidden bg-white"
          >
            <div class="md:col-span-3 relative bg-callsun-tint aspect-square">
              <img
                src={k.cardImage}
                alt=""
                loading="lazy"
                class="absolute inset-0 w-full h-full object-contain p-4 md:p-6"
              />
            </div>
            <div class="md:col-span-2 p-6 md:p-8 flex flex-col justify-center gap-3">
              <h4 class="font-display text-lg md:text-xl font-extrabold text-callsun-ink leading-snug">
                {k.short}
              </h4>
              <p class="text-callsun-mute text-sm">
                {k.specsInline}
              </p>
              <span class="mt-2 inline-flex items-center gap-2 font-bold text-xs tracking-wider uppercase text-callsun-ink group-hover:text-callsun-lime transition-colors">
                VIEW SYSTEM <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════════════
       Project Inquiry CTA
       ═══════════════════════════════════════════════════════════════════════ */}
  <section class="bg-callsun-ink text-white">
    <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-16 md:py-20">
      <div class="grid grid-cols-1 md:grid-cols-5 gap-8 items-center">
        <div class="md:col-span-3">
          <Eyebrow class="mb-3">{SOLUTIONS_L1.inquiry.eyebrow}</Eyebrow>
          <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-extrabold text-white leading-[1.1]">
            {SOLUTIONS_L1.inquiry.title}
          </h2>
          <p class="mt-4 text-white/70 text-base md:text-lg leading-relaxed max-w-2xl">
            {SOLUTIONS_L1.inquiry.subtitle}
          </p>
        </div>
        <div class="md:col-span-2 md:text-right">
          <a
            href={SOLUTIONS_L1.inquiry.cta.href}
            class="inline-flex items-center gap-2 bg-callsun text-callsun-ink font-bold text-sm tracking-wider px-8 py-4 hover:bg-callsun-limeHi transition-colors"
          >
            {SOLUTIONS_L1.inquiry.cta.label} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
