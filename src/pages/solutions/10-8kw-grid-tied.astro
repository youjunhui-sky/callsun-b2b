  {/* Gallery + tab interaction script */}
  <script is:inline>
    (function () {
      /* -------- Gallery -------- */
      const groot = document.querySelector('[data-gallery="kit-10-8kw"]');
      if (groot) {
        const slides   = Array.from(groot.querySelectorAll('[data-slide]'));
        const thumbs   = Array.from(groot.querySelectorAll('[data-thumb]'));
        const prevBtn  = groot.querySelector('[data-prev]');
        const nextBtn  = groot.querySelector('[data-next]');
        const counter  = groot.querySelector('[data-counter]');
        const ribbon   = groot.querySelector('[data-ribbon]');
        const total    = slides.length;
        let current    = 0;

        function show(i) {
          current = (i + total) % total;
          slides.forEach((s, idx) => {
            s.classList.toggle('opacity-100', idx === current);
            s.classList.toggle('opacity-0', idx !== current);
            s.classList.toggle('pointer-events-none', idx !== current);
          });
          thumbs.forEach((t, idx) => {
            if (idx === current) {
              t.classList.add('border-callsun-lime', 'border-2');
              t.classList.remove('border-callsun-line');
            } else {
              t.classList.remove('border-callsun-lime', 'border-2');
              t.classList.add('border-callsun-line');
            }
          });
          if (counter) counter.textContent = (current + 1) + ' / ' + total;
          if (ribbon) ribbon.style.display = current === 0 ? '' : 'none';
        }

        prevBtn && prevBtn.addEventListener('click', () => show(current - 1));
        nextBtn && nextBtn.addEventListener('click', () => show(current + 1));
        thumbs.forEach((t, idx) => t.addEventListener('click', () => show(idx)));
        groot.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') show(current - 1);
          if (e.key === 'ArrowRight') show(current + 1);
        });
      }

      /* -------- Tabs (navigation-only: scroll to section) -------- */
      const troot = document.querySelector('[data-tabs="kit-10-8kw"]');
      if (!troot) return;
      const tabs   = Array.from(troot.querySelectorAll('[data-tab]'));
      const panels = Array.from(document.querySelectorAll('[data-panel]'));
      const ids    = panels.map((p) => p.getAttribute('data-panel'));

      function setActive(id) {
        tabs.forEach((t) => {
          const on = t.getAttribute('data-tab') === id;
          const underline = t.querySelector('[data-tab-underline]');
          if (on) {
            t.classList.add('text-callsun-ink', 'bg-callsun-tint');
            t.classList.remove('text-callsun-mute', 'hover:text-callsun-ink', 'hover:bg-callsun-tint/60');
            if (underline) {
              underline.classList.add('scale-x-100');
              underline.classList.remove('scale-x-0');
            }
          } else {
            t.classList.remove('text-callsun-ink', 'bg-callsun-tint');
            t.classList.add('text-callsun-mute', 'hover:text-callsun-ink', 'hover:bg-callsun-tint/60');
            if (underline) {
              underline.classList.add('scale-x-0');
              underline.classList.remove('scale-x-100');
            }
          }
        });
      }

      function scrollTo(id) {
        const panel = document.querySelector('[data-panel="' + id + '"]');
        if (!panel) return;
        const bar = troot.getBoundingClientRect();
        const y = window.scrollY + panel.getBoundingClientRect().top - bar.height - 12;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }

      tabs.forEach((t) => t.addEventListener('click', () => {
        const id = t.getAttribute('data-tab');
        setActive(id);
        history.replaceState(null, '', '#' + id);
        scrollTo(id);
      }));

      /* External anchor triggers (e.g. DOWNLOAD MANUAL button) */
      document.querySelectorAll('[data-tab-link]').forEach((el) => {
        el.addEventListener('click', (e) => {
          const id = el.getAttribute('data-tab-link');
          if (!id) return;
          e.preventDefault();
          setActive(id);
          history.replaceState(null, '', '#' + id);
          scrollTo(id);
        });
      });

      /* Update active tab while user scrolls (spy) */
      const io = new IntersectionObserver((entries) => {
        /* Find the panel whose top is closest to the sticky-bar bottom */
        let bestId = null;
        let bestTop = Infinity;
        panels.forEach((p) => {
          const rect = p.getBoundingClientRect();
          const barH = troot.getBoundingClientRect().height;
          /* pick the section whose top is <= (barH + 20) and > -rect.height */
          if (rect.top <= barH + 40 && rect.bottom > barH + 40) {
            const dist = Math.abs(rect.top - barH);
            if (dist < bestTop) { bestTop = dist; bestId = p.getAttribute('data-panel'); }
          }
        });
        if (bestId) setActive(bestId);
      }, { threshold: [0, 0.1, 0.5, 0.9, 1] });
      panels.forEach((p) => io.observe(p));

      /* Deep-link support: #description, #specs, ... */
      const initial = (location.hash || '#description').slice(1);
      if (ids.indexOf(initial) !== -1) {
        setActive(initial);
        /* Delay so browser doesn't fight us for the same anchor */
        setTimeout(() => scrollTo(initial), 100);
      }
    })();
  </script>
