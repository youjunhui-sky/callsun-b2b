---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/data/site';
---
<BaseLayout title={`${SITE.name} — ${SITE.tagline}`}>
  <Header slot="header" />
  <Footer slot="footer" />

  <!-- 首页占位。真实首页按 0-首页 原型 1:1 复刻，在下一步骤实施 -->
  <section class="relative overflow-hidden bg-callsun-ink text-white">
    <div class="absolute inset-0 opacity-40 bg-[radial-gradient(ellipse_at_top_left,rgba(198,246,0,0.25),transparent_60%)]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-content px-4 sm:px-6 lg:px-10 py-24 md:py-32 lg:py-40">
      <p class="text-callsun-lime text-xs font-semibold tracking-eyebrow uppercase mb-5">
        Foundation Preview · Scaffold Only
      </p>
      <h1 class="font-display text-4xl md:text-6xl lg:text-7xl font-extrabold leading-[1.05] max-w-3xl">
        Callsun B2B<br />
        <span class="text-callsun-lime">Rebuild in Progress</span>
      </h1>
      <p class="mt-6 max-w-2xl text-white/70 text-base md:text-lg leading-relaxed">
        This is the new <code class="text-callsun-lime">callsun-b2b</code> workspace scaffold.
        Homepage, product pages, solutions, resource center, news &amp; cases and the brand
        page are being rebuilt page-by-page from the 2026-07-23 client prototypes.
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/products/" class="inline-flex items-center gap-2 bg-callsun text-callsun-ink font-bold text-sm tracking-wider px-6 py-3 hover:bg-callsun-limeHi transition-colors">
          EXPLORE PRODUCTS <span aria-hidden="true">→</span>
        </a>
        <a href="/contact/" class="inline-flex items-center gap-2 border border-white/40 text-white font-bold text-sm tracking-wider px-6 py-3 hover:border-callsun hover:text-callsun-lime transition-colors">
          DISCUSS REQUIREMENTS <span aria-hidden="true">→</span>
        </a>
      </div>

      <dl class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-6 border-t border-white/10 pt-8">
        <div>
          <dt class="text-xs tracking-eyebrow uppercase text-white/50">Manufacturing Area</dt>
          <dd class="mt-1 font-display text-2xl md:text-3xl font-bold">55,000 m²</dd>
        </div>
        <div>
          <dt class="text-xs tracking-eyebrow uppercase text-white/50">Manufacturing Bases</dt>
          <dd class="mt-1 font-display text-2xl md:text-3xl font-bold">4</dd>
        </div>
        <div>
          <dt class="text-xs tracking-eyebrow uppercase text-white/50">Global Logistics</dt>
          <dd class="mt-1 font-display text-2xl md:text-3xl font-bold">6+</dd>
        </div>
        <div>
          <dt class="text-xs tracking-eyebrow uppercase text-white/50">Module Power Range</dt>
          <dd class="mt-1 font-display text-2xl md:text-3xl font-bold">180–720W</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="bg-callsun-bg">
    <div class="mx-auto max-w-content px-4 sm:px-6 lg:px-10 py-16">
      <p class="text-callsun-mute text-xs tracking-eyebrow uppercase mb-3">Rebuild Roadmap</p>
      <h2 class="font-display text-2xl md:text-3xl font-bold text-callsun-ink">
        Pages being rebuilt from client prototypes
      </h2>
      <ol class="mt-8 grid md:grid-cols-2 gap-4 text-sm">
        {[
          '0 · Homepage — hero + 4 KPIs + 8 product grid + certifications + global supply + articles/videos + inquiry',
          '1 · Products L1 — Standard / Custom category hub',
          '1a · Standard PV Modules L2 — CN450 · CN580 · CN620 · CN720',
          '1b · Custom PV Modules L2 — CN180 · CN200 · CN215',
          '1c · Product Detail — 7 SKUs (specs + features + downloads + inquiry)',
          '2 · Solutions L1 — Grid-Tied · Off-Grid',
          '2a · Solution Detail — 5.4kW · 7.2kW · 10.8kW',
          '3 · Resource Center — Downloads · FAQ · Video Center',
          '4 · News & Cases — Blog · Gallery · Project List',
          '5 · About Callsun — Brand & Global Supply',
        ].map((line, i) => (
          <li class="flex items-start gap-3 border border-callsun-line bg-white px-4 py-3">
            <span class="text-callsun-lime font-bold text-xs tracking-eyebrow shrink-0">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="text-callsun-mute">{line}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
