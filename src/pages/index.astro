---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import InquiryForm from '@/components/InquiryForm.astro';
import SocialIcons from '@/components/SocialIcons.astro';
import { SITE } from '@/data/site';
import {
  HERO,
  HOME_PRODUCTS,
  QUALITY,
  GLOBAL_SUPPLY,
  ARTICLES,
  VIDEOS,
  INQUIRY,
} from '@/data/homepage';

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.domain,
};
---
<BaseLayout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.defaultDescription}
  canonical="/"
  schema={homeSchema}
>
  <Header slot="header" />
  <Footer slot="footer" />

  {/* ═══════════════════════════════════════════════════════════════════════
       Section 1: HERO CAROUSEL (5 images, auto-play, dot nav)
       ═══════════════════════════════════════════════════════════════════════ */}
  <section id="hero-carousel" class="relative overflow-hidden text-white">
    {/* Slides: 8 designed hero images (text baked in). Container is fixed 2.2:1 (11/5) so images are cropped consistently on every screen; keep text within the central safe area. */}
    <div class="relative w-full aspect-[11/5] min-h-[380px]">
      {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => (
        <img
          src={`/uploads/callsun/home/hero-carousel/${n}.jpg`}
          alt=""
          loading={n === 1 ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={n === 1 ? 'high' : 'auto'}
          class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ${n === 1 ? 'opacity-100' : 'opacity-0'}`}
          style='object-position: center;'
          data-slide={n}
        />
      ))}

      {/* Prev / Next arrows */}
      <button
        type="button"
        aria-label="Previous slide"
        data-prev
        class="absolute left-3 md:left-6 top-1/2 -translate-y-1/2 z-10 flex h-10 w-10 md:h-12 md:w-12 items-center justify-center rounded-full bg-black/15 text-white/60 hover:bg-callsun hover:text-callsun-ink transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        type="button"
        aria-label="Next slide"
        data-next
        class="absolute right-3 md:right-6 top-1/2 -translate-y-1/2 z-10 flex h-10 w-10 md:h-12 md:w-12 items-center justify-center rounded-full bg-black/15 text-white/60 hover:bg-callsun hover:text-callsun-ink transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      {/* Dot nav removed — arrows only */}
    </div>

  </section>

  {/* ═══════════════════════════════════════════════════════════════════════
       Section 3: Product Grid (2 rows × 4 cols = 8 cards)
       ═══════════════════════════════════════════════════════════════════════ */}
  <section class="bg-white">
    <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-16 md:py-20 lg:py-24">

      <div class="mb-10 md:mb-14">
        <div class="flex items-baseline gap-3 md:gap-4 mb-5 md:mb-6">
          <h3 class="font-display font-extrabold text-callsun-lime text-base md:text-lg uppercase tracking-eyebrow shrink-0">Standard PV Modules</h3>
          <div class="flex-1 h-px bg-callsun-line"></div>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
          {HOME_PRODUCTS.filter((p) => p.tag === 'STANDARD').map((p) => (
            <li>
              <a
                href={p.href}
                class="group flex flex-col h-full border border-callsun-line bg-white hover:border-callsun-ink hover:shadow-card transition-all"
              >
                <div class="relative aspect-square overflow-hidden bg-callsun-surface">
                  <img
                    src={p.image}
                    alt={p.name}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-contain p-4 transition-transform duration-500 group-hover:scale-[1.04]"
                  />
                </div>
                <div class="flex-1 p-4 md:p-5 flex flex-col gap-2">
                  <p class="text-xs font-bold tracking-eyebrow uppercase text-callsun-lime">
                    {p.model}
                  </p>
                  <h4 class="font-display font-bold text-[15px] leading-snug flex-1 text-callsun-ink">
                    {p.name}
                  </h4>
                  <span class="text-xs font-semibold tracking-wider mt-1 inline-flex items-center gap-1 text-callsun-ink group-hover:text-callsun-lime">
                    PRODUCT DETAILS
                    <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <div class="flex items-baseline gap-3 md:gap-4 mb-5 md:mb-6">
          <h3 class="font-display font-extrabold text-callsun-lime text-base md:text-lg uppercase tracking-eyebrow shrink-0">Custom PV Modules</h3>
          <div class="flex-1 h-px bg-callsun-line"></div>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
          {HOME_PRODUCTS.filter((p) => p.tag === 'CUSTOM').map((p) => (
            <li>
              <a
                href={p.href}
                class="group flex flex-col h-full border border-callsun-line bg-white hover:border-callsun-ink hover:shadow-card transition-all"
              >
                <div class="relative aspect-square overflow-hidden bg-callsun-surface">
                  <img
                    src={p.image}
                    alt={p.name}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-contain p-4 transition-transform duration-500 group-hover:scale-[1.04]"
                  />
                </div>
                <div class="flex-1 p-4 md:p-5 flex flex-col gap-2">
                  <p class="text-xs font-bold tracking-eyebrow uppercase text-callsun-lime">
                    {p.model}
                  </p>
                  <h4 class="font-display font-bold text-[15px] leading-snug flex-1 text-callsun-ink">
                    {p.name}
                  </h4>
                  <span class="text-xs font-semibold tracking-wider mt-1 inline-flex items-center gap-1 text-callsun-ink group-hover:text-callsun-lime">
                    PRODUCT DETAILS
                    <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════════════
       Section 4: Quality You Can Verify
       ═══════════════════════════════════════════════════════════════════════ */}
  <section class="bg-callsun-tint">
    <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-16 md:py-20 lg:py-24">
      <img
        src={QUALITY.certificateImage}
        alt="Quality You Can Verify — Callsun product certifications on display"
        loading="lazy"
        class="block w-full h-auto object-contain"
      />
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════════════
       Section 5: Global Supply
       ═══════════════════════════════════════════════════════════════════════ */}
  <section>
    <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-16 md:py-20 lg:py-24">
      <img
        src="/uploads/callsun/homepage/global-supply.jpg"
        alt="Global Supply — Callsun manufacturing bases and logistics network"
        loading="lazy"
        class="block w-full h-auto object-cover"
      />
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════════════
       Section 6: Technical Content (Articles + Videos)
       ═══════════════════════════════════════════════════════════════════════ */}
  <section class="bg-white">
    <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-16 md:py-20 lg:py-24">
      <div class="max-w-3xl mb-10 md:mb-14">
        <Eyebrow color="lime" class="mb-3">INSIGHTS &amp; VIDEOS</Eyebrow>
        <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-extrabold text-callsun-ink">
          Technical Content from Callsun
        </h2>
      </div>

      {/* Latest Articles */}
      <div class="mb-14">
        <div class="flex items-center justify-between mb-6">
          <Eyebrow color="lime">LATEST ARTICLES</Eyebrow>
          <a href="/news/" class="text-xs font-bold tracking-eyebrow uppercase text-callsun-mute hover:text-callsun-ink transition-colors">
            VIEW ALL →
          </a>
        </div>
        <ul class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
          {ARTICLES.map((a) => (
            <li>
              <a href={a.href} class="group flex flex-col h-full bg-white border border-callsun-line hover:border-callsun-ink hover:shadow-card transition-all">
                <div class="relative aspect-[16/10] overflow-hidden bg-callsun-surface">
                  <img
                    src={a.image}
                    alt={a.title}
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                  />
                </div>
                <div class="flex-1 p-5 flex flex-col gap-3">
                  <div class="flex items-center gap-3 text-[10px] font-bold tracking-eyebrow uppercase">
                    <span class="text-callsun-lime">{a.category}</span>
                    <span class="text-callsun-muteLight">·</span>
                    <span class="text-callsun-mute">{a.date}</span>
                  </div>
                  <h3 class="font-display font-bold text-lg leading-snug text-callsun-ink flex-1">
                    {a.title}
                  </h3>
                  <span class="text-xs font-semibold tracking-wider text-callsun-ink group-hover:text-callsun-lime transition-colors inline-flex items-center gap-1">
                    READ <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* Featured Videos */}
      <div id="featured-videos">
        <div class="flex items-center justify-between mb-8 md:mb-10">
          <Eyebrow color="lime">FEATURED VIDEOS</Eyebrow>
          <a href="/resources/#video-center" class="text-xs font-bold tracking-eyebrow uppercase text-callsun-mute hover:text-callsun-ink transition-colors">
            VIDEO CENTER →
          </a>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-5">
          {VIDEOS.map((v) => (
            <li>
              <a
                href={v.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group block bg-white text-callsun-ink overflow-hidden border border-callsun-line hover:border-callsun-lime transition-colors"
              >
                <div class="relative aspect-video overflow-hidden bg-black">
                  <img
                    src={v.thumb}
                    alt={v.title}
                    loading="lazy"
                    class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-[1.04] transition-all duration-500"
                  />
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="w-14 h-14 bg-callsun/90 flex items-center justify-center group-hover:bg-callsun transition-colors">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#0F0F0E">
                        <polygon points="6,4 20,12 6,20"/>
                      </svg>
                    </div>
                  </div>
                </div>
                <div class="p-4 md:p-5">
                  <p class="text-[10px] font-bold tracking-eyebrow uppercase text-callsun-lime">VIDEO</p>
                  <h3 class="mt-2 font-display font-bold text-base leading-snug text-callsun-ink truncate">
                    {v.title}
                  </h3>
                  <p class="mt-2 text-xs tracking-eyebrow uppercase text-callsun-mute">
                    {v.channel} <span aria-hidden="true">↗</span>
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════════════════════════════════
       Section 7: Inquiry (Light Grey BG, Left Text + Right Form)
       ═══════════════════════════════════════════════════════════════════════ */}
  <section id="inquiry" class="bg-callsun-ink text-white">
    <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-16 md:py-20 lg:py-24">
      <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] gap-10 lg:gap-16 items-start">
        <div>
          <Eyebrow class="mb-3">{INQUIRY.eyebrow}</Eyebrow>
          <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-extrabold text-white leading-[1.1]">
            {INQUIRY.title}
          </h2>
          <p class="mt-6 text-white/70 text-base leading-relaxed max-w-lg">
            {INQUIRY.intro}
          </p>

          <SocialIcons class="mt-8" />
        </div>

        <InquiryForm formSource="homepage" formTitle={INQUIRY.formTitle} />
      </div>
    </div>
  </section>

  <script>
  (() => {
    const TOTAL = 8;
    let current = 1;
    let timer = null;

    const slides = document.querySelectorAll('[data-slide]');
    const section = document.getElementById('hero-carousel');

    function goTo(n) {
      if (n === current) return;
      slides.forEach((el) => {
        el.classList.remove('opacity-100');
        el.classList.add('opacity-0');
      });
      const next = document.querySelector(`[data-slide="${n}"]`);
      if (next) {
        next.classList.remove('opacity-0');
        next.classList.add('opacity-100');
      }
      current = n;
    }

    function next() {
      goTo(current < TOTAL ? current + 1 : 1);
    }

    function prev() {
      goTo(current > 1 ? current - 1 : TOTAL);
    }

    function startAuto() {
      stopAuto();
      timer = setInterval(next, 4000);
    }

    function stopAuto() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    // Arrow clicks
    const prevBtn = document.querySelector('[data-prev]');
    const nextBtn = document.querySelector('[data-next]');
    if (prevBtn) prevBtn.addEventListener('click', () => { prev(); startAuto(); });
    if (nextBtn) nextBtn.addEventListener('click', () => { next(); startAuto(); });

    // Pause on hover
    if (section) {
      section.addEventListener('mouseenter', stopAuto);
      section.addEventListener('mouseleave', startAuto);
    }

    startAuto();
  })();
</script>
</BaseLayout>
