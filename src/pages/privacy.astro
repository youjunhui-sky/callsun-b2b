---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { SITE } from '@/data/site';
---
<BaseLayout title={`Privacy Policy — ${SITE.name}`} description="Callsun privacy policy — how we collect, use and protect your information.">
  <Header slot="header" />
  <Footer slot="footer" />

  <section class="bg-callsun-ink text-white">
    <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-16 md:py-20">
      <Eyebrow class="mb-4">LEGAL</Eyebrow>
      <h1 class="font-display text-4xl md:text-5xl font-extrabold leading-[1.05]">Privacy Policy</h1>
      <p class="mt-4 text-white/60 text-sm">Last updated: August 2026</p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-10 py-14 md:py-20 text-sm leading-relaxed text-callsun-ink space-y-8">
      <div>
        <h2 class="font-display text-xl font-extrabold mb-3">1. Information We Collect</h2>
        <p>
          When you submit an inquiry on this website, we collect the information you provide: your name,
          business email, company, country, product of interest, project requirements, and any file you
          attach. We also collect technical data needed to operate the site: browser type, device type,
          IP country, pages visited, referring website, and UTM campaign parameters when you arrive from
          advertising links.
        </p>
      </div>
      <div>
        <h2 class="font-display text-xl font-extrabold mb-3">2. How We Use Your Information</h2>
        <ul class="list-disc pl-5 space-y-1">
          <li>To respond to your inquiry and provide quotations or product information.</li>
          <li>To manage and track sales follow-ups internally (our CRM).</li>
          <li>To analyse website traffic and campaign performance with consent-based analytics tools.</li>
          <li>To improve our products and website experience.</li>
        </ul>
      </div>
      <div>
        <h2 class="font-display text-xl font-extrabold mb-3">3. Cookies &amp; Marketing Tags</h2>
        <p>
          We use a cookie consent banner. Analytics and advertising tags (such as Google Analytics 4 and
          Google Tag Manager) only run after you click <strong>Accept</strong>. You can decline, and the
          tags will not load. You may clear cookies or change your choice at any time in your browser.
        </p>
      </div>
      <div>
        <h2 class="font-display text-xl font-extrabold mb-3">4. Data Retention &amp; Security</h2>
        <p>
          Inquiry records are stored in our secured database, transmitted over HTTPS, and protected
          against spam submissions. We retain records as long as needed for sales follow-up and
          business analysis. We do not sell your personal data to third parties.
          Marketing/analytics data is processed by the respective providers (Google) under their
          data-processing terms.
        </p>
      </div>
      <div>
        <h2 class="font-display text-xl font-extrabold mb-3">5. Your Rights</h2>
        <p>
          You may request access to, correction of, or deletion of your personal data at any time by
          contacting <a class="underline" href={`mailto:${SITE.organization.contact.support}`}>{SITE.organization.contact.support}</a>.
        </p>
      </div>
      <div>
        <h2 class="font-display text-xl font-extrabold mb-3">6. Contact</h2>
        <p>
          Questions about this policy: <a class="underline" href={`mailto:${SITE.organization.contact.sales}`}>{SITE.organization.contact.sales}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
