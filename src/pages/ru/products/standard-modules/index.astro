---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import InquiryForm from '@/components/InquiryForm.astro';
import { SITE } from '@/data/site';
import { STANDARD_L2 } from '@/data/standard-l2';
import { STANDARD_L2_RU } from '@/i18n/data/standard-l2-ru';
import { UI } from '@/i18n/ui';

const t = UI.ru;
const de = STANDARD_L2_RU;
// 规格值（mm/kg/V/A）通用，仅标签和效率行需本地化
const effDe: Record<string, string> = {
  '22.52% MODULE EFFICIENCY': '22,52 % MODULEFFIZIENZ',
  '22.45% MODULE EFFICIENCY': '22,45 % MODULEFFIZIENZ',
  '22.95% MODULE EFFICIENCY': '22,95 % MODULEFFIZIENZ',
  '23.18% MODULE EFFICIENCY': '23,18 % MODULEFFIZIENZ',
};
const skus = STANDARD_L2.skus.map((s) => ({
  ...s,
  efficiency: effDe[s.efficiency] || s.efficiency,
  specs: s.specs.map((sp) => ({
    label:
      sp.label === 'DIMENSIONS' ? de.specLabels.dimensions :
      sp.label === 'WEIGHT' ? de.specLabels.weight :
      sp.label === 'OPERATING POINT' ? de.specLabels.operatingPoint :
      sp.label === 'OPEN / SHORT CIRCUIT' ? de.specLabels.ocsc :
      sp.label === 'CONSTRUCTION' ? de.specLabels.construction : sp.label,
    value: sp.value,
  })),
  detailHref: s.detailHref,
}));
---
<BaseLayout
  title={`Standard-PV-Module — ${SITE.name}`}
  description={de.hero.subtitle}
  canonical="/ru/products/standard-modules/"
  locale="ru"
>
  <Header slot="header" locale="ru" />
  <Footer slot="footer" locale="ru" />

  <section class="relative overflow-hidden bg-callsun-ink text-white aspect-[11/5] min-h-[520px]">
    <img src="/uploads/callsun/products/standard-hero.webp" alt="" loading="eager" decoding="async" fetchpriority="high" class="absolute inset-0 w-full h-full object-cover" />
    <div class="relative mx-auto max-w-wide px-4 sm:px-6 lg:px-10 pt-20 pb-16 md:pt-24 md:pb-20 lg:pt-28 lg:pb-24">
      <Breadcrumbs items={de.breadcrumb} theme="dark" />
      <div class="max-w-3xl">
        <h1 class="mt-6 font-display text-4xl md:text-5xl lg:text-6xl font-extrabold leading-[1.05]">
          {de.hero.title}
        </h1>
        <p class="mt-8 font-display text-3xl md:text-4xl lg:text-5xl font-medium text-callsun-lime tracking-tight">
          {de.hero.powerRange}
        </p>
        <a href={de.hero.cta.href} class="mt-10 inline-flex items-center gap-2 bg-callsun text-callsun-ink font-bold text-sm tracking-wider px-6 py-3.5 hover:bg-callsun-limeHi transition-colors shadow-lg">
          {de.hero.cta.label} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white">
    {skus.map((sku, i) => {
      const alt = i % 2 === 1;
      const bandBg = i % 2 === 0 ? 'bg-white' : 'bg-callsun-tint';
      const galleryOrder = alt ? 'order-2 col-span-3' : 'order-1 col-span-3';
      const textOrder = alt ? 'order-1 col-span-2' : 'order-2 col-span-2';
      return (
        <div id={sku.key} class={`${bandBg} border-b border-callsun-line`}>
          <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-14 md:py-20 lg:py-24">
            <div class="grid grid-cols-5 gap-8 md:gap-10 lg:gap-14 items-start">
              <div class={galleryOrder}>
                <div class="relative bg-white shadow-[0_20px_60px_-24px_rgba(0,0,0,0.35)] overflow-hidden border border-callsun-line/50">
                  <div class="relative" style="aspect-ratio: 4/3;">
                    <img src={sku.images[0]} alt={sku.title} loading="lazy" class="absolute inset-0 w-full h-full object-contain p-4 md:p-8 lg:p-10" />
                  </div>
                </div>
              </div>
              <div class={textOrder}>
                <div class="mt-6 flex flex-wrap items-baseline gap-4">
                  <span class="inline-block bg-callsun text-callsun-ink font-display font-extrabold text-3xl md:text-4xl px-4 py-2 leading-none">
                    {sku.power}
                  </span>
                  <span class="text-[11px] md:text-xs font-bold tracking-eyebrow uppercase text-callsun-lime">
                    {sku.efficiency}
                  </span>
                </div>
                <dl class="mt-7 grid grid-cols-2 gap-x-8 gap-y-3">
                  {sku.specs.map((s) => (
                    <div class="border-t border-callsun-line pt-2">
                      <dt class="text-[10px] font-bold tracking-eyebrow uppercase text-callsun-mute">{s.label}</dt>
                      <dd class="mt-1 font-semibold text-sm text-callsun-ink normal-case">{s.value}</dd>
                    </div>
                  ))}
                </dl>
                <div class="mt-8 flex flex-wrap items-center gap-6">
                  <a href={sku.detailHref} class="inline-flex items-center gap-2 font-bold text-sm tracking-wider uppercase text-callsun-ink hover:text-callsun-lime border-b-2 border-callsun-ink hover:border-callsun-lime pb-1 transition-colors">
                    {t.productsL2.viewDetails} <span aria-hidden="true">→</span>
                  </a>
                  <a href={sku.datasheetHref} target="_blank" rel="noopener" class="inline-flex items-center gap-2 font-bold text-sm tracking-wider uppercase text-callsun-mute hover:text-callsun-ink transition-colors">
                    {t.productsL2.downloadDatasheet} <span aria-hidden="true">↓</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </section>

  <section id="inquiry" class="bg-callsun-ink text-white">
    <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 py-16 md:py-20 lg:py-24">
      <div class="grid grid-cols-5 gap-10 lg:gap-16 items-start">
        <div class="col-span-2">
          <Eyebrow class="mb-3">{de.inquiry.eyebrow}</Eyebrow>
          <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-extrabold text-white leading-[1.1]">
            {de.inquiry.title}
          </h2>
          <p class="mt-6 text-white/70 text-base leading-relaxed max-w-lg">
            {de.inquiry.intro}
          </p>
        </div>
        <div class="col-span-3">
          <InquiryForm locale="ru" formSource="standard-l2-ru" formTitle={de.inquiry.formTitle} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
