---
/**
 * SocialIcons — Callsun 官方社媒圆形图标组
 * 2026-08-04 客户要求：首页 inquiry 区 + about 页 CTA 共用
 * 链接来源：东家 2026-08-04 19:44 提供
 */
export interface Props {
  /** 图标对齐方式 */
  align?: 'start' | 'center' | 'end';
  /** 额外 class，加在 <ul> 上 */
  class?: string;
  /** 图标直径（px，默认 44 = h-11 w-11） */
  size?: number;
}

const { align = 'start', class: className = '', size = 44 } = Astro.props;

const SOCIALS: { name: string; href: string; d?: string; instagram?: boolean }[] = [
  {
    name: 'Facebook',
    href: 'https://www.facebook.com/Callsunsolar/',
    d: 'M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.5-3.9 3.78-3.9 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z',
  },
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/callsunsolar/',
    instagram: true,
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/company/callsun/',
    d: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z',
  },
  {
    name: 'YouTube',
    href: 'https://www.youtube.com/@Callsunsolar',
    d: 'M23.5 6.2a3 3 0 0 0-2.12-2.12C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.53A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.12 2.12c1.88.53 9.38.53 9.38.53s7.5 0 9.38-.53a3 3 0 0 0 2.12-2.12A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6z',
  },
  {
    name: 'Email',
    href: 'mailto:sales@callsunsolar.com',
    d: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm0 2v.4l9 5.4 9-5.4V7l-9 5.4L3 7z',
  },
];

const justifyClass =
  align === 'center'
    ? 'justify-center'
    : align === 'end'
    ? 'justify-end lg:justify-end justify-center'
    : 'justify-start';
---

<ul class={`flex items-center gap-3 flex-wrap ${justifyClass} ${className}`}>
  {SOCIALS.map((s) => (
    <li>
      <a
        href={s.href}
        target={s.href.startsWith('http') ? '_blank' : undefined}
        rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        aria-label={s.name}
        class={`flex items-center justify-center rounded-full bg-callsun text-callsun-ink hover:bg-callsun-limeHi hover:scale-105 transition-all`}
        style={`width:${size}px;height:${size}px;`}
      >
        {s.instagram ? (
          <svg xmlns="http://www.w3.org/2000/svg" width={size * 0.45} height={size * 0.45} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="5" ry="5" />
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
            <line x1="17.5" y1="6.5" x2="17.5" y2="6.5" />
          </svg>
        ) : (
          <svg xmlns="http://www.w3.org/2000/svg" width={size * 0.45} height={size * 0.45} viewBox="0 0 24 24" fill="currentColor">
            <path d={s.d} />
          </svg>
        )}
      </a>
    </li>
  ))}
</ul>
