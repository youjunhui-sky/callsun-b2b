---
import { NAV } from '@/data/site';
import { UI } from '@/i18n/ui';
import { localePath, basePathOf, LOCALES, localeLabel, type Locale } from '@/i18n/config';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = UI[locale];
const currentPath = Astro.url.pathname;
const basePath = basePathOf(currentPath);

// NAV 标签按语言渲染（本地化页面用翻译，未本地化页面路径不变）
const navLabel = (label: string): string => {
  if (locale === 'en') return label;
  const map: Record<string, string> = {
    'HOME': t.nav.home, 'PRODUCTS': t.nav.products,
    'Standard PV Modules': t.nav.standard, 'Custom PV Modules': t.nav.custom,
    'SOLUTIONS': t.nav.solutions,
    '5.4kW Off-Grid Kit': t.nav.kit54, '7.2kW Grid-Tied Kit': t.nav.kit72, '10.8kW Grid-Tied Kit': t.nav.kit108,
    'RESOURCES': t.nav.resources, 'Downloads': t.nav.downloads,
    'Product & Cooperation FAQ': t.nav.faq, 'Video Center': t.nav.videoCenter,
    'NEWS & CASES': t.nav.news, 'Technical Blog': t.nav.blog, 'Project List': t.nav.projects,
    'ABOUT': t.nav.about,
  };
  return map[label] || label;
};

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href);
}

// 本地化页面的导航链接带语言前缀；未本地化路径保持原样（英语页）
const navHref = (href: string): string => {
  if (locale === 'en') return href;
  const base = href.split('#')[0];
  const localized = ['/products/', '/products/standard-modules/', '/products/custom-modules/', '/about/', '/solutions/', '/resources/', '/news/', '/contact/', '/'];
  if (localized.includes(base)) {
    const prefixed = `/${locale}${base === '/' ? '/' : base}`;
    return href.includes('#') ? `${prefixed}${'#' + href.split('#')[1]}` : prefixed;
  }
  return href;
};

const otherLocales = LOCALES.filter((l) => l !== locale);
---
<header class="sticky top-0 z-40 bg-callsun-ink text-white border-b border-callsun-lineDark">
  <div class="mx-auto max-w-wide px-4 sm:px-6 lg:px-10 h-16 flex items-center justify-between gap-4">
    <a href={navHref('/')} class="flex items-center gap-2 shrink-0" aria-label="Callsun home">
      <img src="/logo.png" alt="Callsun" class="h-7 w-auto" />
    </a>

    <nav class="hidden lg:flex items-center gap-7 text-[13px] font-medium tracking-wider">
      {NAV.map((item: any) => (
        item.children && item.children.length ? (
          <div class="relative group">
            <a
              href={navHref(item.href)}
              class:list={[
                'inline-flex items-center gap-1 transition-colors py-4',
                isActive(item.href) ? 'text-callsun-lime' : 'text-white/85 group-hover:text-callsun-lime',
              ]}
              aria-haspopup="true"
            >
              {navLabel(item.label)}
            </a>
            <div
              class="invisible opacity-0 group-hover:visible group-hover:opacity-100 focus-within:visible focus-within:opacity-100 transition-all absolute left-0 top-full min-w-[220px] bg-callsun-ink border border-callsun-lineDark shadow-xl py-2 z-50"
              role="menu"
            >
              {item.children.map((c: any) => (
                <a
                  href={navHref(c.href)}
                  role="menuitem"
                  class:list={[
                    'block px-4 py-2 text-[13px] font-medium tracking-wide transition-colors',
                    currentPath === c.href ? 'text-callsun-lime' : 'text-white/85 hover:text-callsun-lime hover:bg-white/5',
                  ]}
                >
                  {navLabel(c.label)}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={navHref(item.href)}
            class:list={[
              'transition-colors',
              isActive(item.href) ? 'text-callsun-lime' : 'text-white/85 hover:text-callsun-lime',
            ]}
          >
            {navLabel(item.label)}
          </a>
        )
      ))}
    </nav>

    <div class="flex items-center gap-3">
      {/* 语言切换器 */}
      <div class="flex items-center gap-1 text-[11px] font-bold tracking-wider">
        {LOCALES.map((l, i) => (
          <>
            {i > 0 && <span class="text-white/30" aria-hidden="true">·</span>}
            <a
              href={localePath(l, currentPath)}
              hreflang={l === 'en' ? 'en-US' : l === 'de' ? 'de-DE' : 'es-ES'}
              class:list={[
                'px-1 py-1 transition-colors',
                l === locale ? 'text-callsun-lime underline underline-offset-4' : 'text-white/60 hover:text-callsun-lime',
              ]}
              aria-current={l === locale ? 'true' : undefined}
            >
              {localeLabel[l]}
            </a>
          </>
        ))}
      </div>

      <a
        href={navHref('/contact/')}
        class="hidden md:inline-flex items-center gap-1 bg-callsun text-callsun-ink font-bold text-[12px] tracking-wider px-4 py-2.5 hover:bg-callsun-limeHi transition-colors"
      >
        {t.cta.quote} <span aria-hidden="true">→</span>
      </a>

      <button
        type="button"
        id="callsun-mobile-toggle"
        aria-controls="callsun-mobile-nav"
        aria-expanded="false"
        class="lg:hidden text-white p-2"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  <div id="callsun-mobile-nav" hidden class="lg:hidden bg-callsun-ink border-t border-callsun-lineDark">
    <div class="px-4 py-4 flex flex-col gap-3 text-sm font-medium tracking-wider">
      {NAV.map((item: any) => (
        <>
          <a
            href={navHref(item.href)}
            class:list={[
              'py-1.5',
              isActive(item.href) ? 'text-callsun-lime' : 'text-white/85',
            ]}
          >
            {navLabel(item.label)}
          </a>
          {item.children && item.children.map((c: any) => (
            <a
              href={navHref(c.href)}
              class:list={[
                'pl-4 py-1.5 text-[13px]',
                currentPath === c.href ? 'text-callsun-lime' : 'text-white/70',
              ]}
            >
              · {navLabel(c.label)}
            </a>
          ))}
        </>
      ))}
      <div class="flex items-center gap-2 text-[11px] font-bold pt-1">
        {LOCALES.map((l) => (
          <a
            href={localePath(l, currentPath)}
            class:list={[
              'px-2 py-1 border',
              l === locale ? 'border-callsun-lime text-callsun-lime' : 'border-white/25 text-white/60',
            ]}
          >
            {localeLabel[l]}
          </a>
        ))}
      </div>
      <a
        href={navHref('/contact/')}
        class="mt-2 inline-flex items-center gap-1 bg-callsun text-callsun-ink font-bold text-[12px] tracking-wider px-4 py-2.5"
      >
        {t.cta.quote} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</header>
